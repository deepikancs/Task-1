# =========================================================
# ORGANISATION TASK CONTROL CENTRE — GO BACKEND CONFIG
# Copy this file to `.env` and fill in your local MySQL
# credentials. Never commit real passwords to version control.
# =========================================================

# Set DEMO_MODE=true to run with in-memory demo data (skips MySQL connection).
# Set DEMO_MODE=false when you want to connect to your MySQL database.
DEMO_MODE=true

# HTTP Server Port
SERVER_PORT=8080

# Allowed Frontend CORS Origin (Vite Dev Server)
CORS_ALLOWED_ORIGIN=http://localhost:5173

# MySQL Database Connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=Diviga
DB_USER=otcc_app
DB_PASSWORD=YOUR_CHOSEN_PASSWORD

# Default Reference Date when not supplied by client
DEFAULT_DEMO_TODAY=2026-10-11
